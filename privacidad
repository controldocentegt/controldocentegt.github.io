/* =========================
   MENU LATERAL
========================= */

.sidebar{
    width:260px;
    background:#0d47a1;
    color:white;
    padding:25px 20px;
    border-right:4px solid #1565c0;
    display:flex;
    flex-direction:column;
    position:fixed;
    height:100%;
}

.sidebar h2{
    font-size:24px;
    margin-bottom:10px;
}

.sidebar p{
    font-size:14px;
    opacity:0.9;
    margin-bottom:30px;
}

.menu{
    display:flex;
    flex-direction:column;
    gap:15px;
}

.menu a{
    text-decoration:none;
    color:white;
    background:rgba(255,255,255,0.12);
    padding:12px;
    border-radius:8px;
    transition:0.3s;
    font-weight:bold;
}

.menu a:hover{
    background:white;
    color:#0d47a1;
}

/* =========================
   CONTENIDO PRINCIPAL
========================= */

.main{
    margin-left:260px;
    width:calc(100% - 260px);
    padding:40px;
}

/* =========================
   ENCABEZADO
========================= */

.hero-banner{
    margin-bottom:25px;
}

.banner-img{
    width:100%;
    border-radius:18px;
    box-shadow:0 4px 14px rgba(0,0,0,0.08);
    object-fit:cover;
}

/* =========================
   HERO
========================= */

.hero{
    background:white;
    border-radius:18px;
    padding:40px;
    box-shadow:0 4px 14px rgba(0,0,0,0.08);
    margin-bottom:30px;
}

.hero-top{
    display:flex;
    align-items:center;
    gap:25px;
    flex-wrap:wrap;
}

.app-logo{
    width:120px;
    height:120px;
    border-radius:20px;
    object-fit:cover;
    border:4px solid #1565c0;
    background:#e3f2fd;
}

.hero h1{
    color:#0d47a1;
    font-size:38px;
    margin-bottom:10px;
}

.hero p{
    line-height:1.8;
    margin-top:10px;
    font-size:17px;
}

/* =========================
   SECCIONES
========================= */

.section{
    background:white;
    border-radius:18px;
    padding:30px;
    margin-bottom:25px;
    box-shadow:0 4px 14px rgba(0,0,0,0.08);
