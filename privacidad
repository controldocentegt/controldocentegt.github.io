/* =========================
   FOOTER
========================= */

.footer{
    margin-top:40px;
    text-align:center;
    padding:25px;
    color:#666;
    font-size:14px;
}

.dev{
    margin-top:10px;
    display:flex;
    justify-content:center;
    align-items:center;
    gap:10px;
}

.dev-logo{
    width:28px;
    height:28px;
    border-radius:50%;
    object-fit:cover;
}

/* =========================
   RESPONSIVE
========================= */

@media(max-width:900px){

    body{
        flex-direction:column;
    }

    .sidebar{
        position:relative;
        width:100%;
        height:auto;
    }

    .main{
        margin-left:0;
        width:100%;
