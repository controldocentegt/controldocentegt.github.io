    padding:12px;
    border-radius:8px;
    transition:0.3s;
    font-weight:bold;
}

.menu a:hover{
    background:white;
    color:#0d47a1;
}

/* =========================
   CONTENIDO PRINCIPAL
========================= */

.main{
    margin-left:260px;
    width:calc(100% - 260px);
    padding:40px;
