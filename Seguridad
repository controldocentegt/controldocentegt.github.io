    height:120px;
    border-radius:20px;
    object-fit:cover;
    border:4px solid #1565c0;
    background:#e3f2fd;
}

.hero h1{
    color:#0d47a1;
    font-size:38px;
    margin-bottom:10px;
}

.hero p{
    line-height:1.8;
    margin-top:10px;
    font-size:17px;
}

/* =========================
   SECCIONES
========================= */

.section{
    background:white;
    border-radius:18px;
    padding:30px;
    margin-bottom:25px;
    box-shadow:0 4px 14px rgba(0,0,0,0.08);
